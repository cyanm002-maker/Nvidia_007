<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sign Up</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<div class="container">

    <div class="card">

        <h1>Create Account</h1>

        <p class="subtitle">
            Create your account
        </p>


        <% if (error) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <form action="/signup" method="POST">


            <label>Name</label>

            <input
                type="text"
                name="name"
                placeholder="Your name"
                required
            >


            <label>Email</label>

            <input
                type="email"
                name="email"
                placeholder="you@example.com"
                required
            >


            <label>Password</label>

            <input
                type="password"
                name="password"
                placeholder="Password"
                minlength="6"
                required
            >


            <label>Age</label>

            <input
                type="number"
                name="age"
                min="0"
                max="150"
                placeholder="25"
                required
            >


            <label>Birthday</label>

            <input
                type="date"
                name="birthday"
                required
            >


            <label>Sex</label>

            <select name="sex" required>

                <option value="">
                    Select
                </option>

                <option value="male">
                    Male
                </option>

                <option value="female">
                    Female
                </option>

                <option value="other">
                    Other
                </option>

                <option value="prefer_not_to_say">
                    Prefer not to say
                </option>

            </select>


            <label>Country</label>

            <input
                type="text"
                name="country"
                placeholder="India"
                required
            >


            <button type="submit">
                Create Account
            </button>

        </form>


        <p class="bottom-text">

            Already have an account?

            <a href="/login">
                Login
            </a>

        </p>

    </div>

</div>

</body>

</html>